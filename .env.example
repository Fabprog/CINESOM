APP_NAME=SoundReel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seu-app.onrender.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=error

# ─── Banco de dados (PostgreSQL no Render) ─────────────────────────────────────
# O Render injeta DB_URL automaticamente via render.yaml.
# Para desenvolvimento local, preencha individualmente:
DB_CONNECTION=pgsql
DB_URL=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=soundreel
# DB_USERNAME=soundreel
# DB_PASSWORD=
# DB_SSLMODE=prefer

# ─── Sessão e cache ────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
TRUSTED_PROXIES=*

CACHE_STORE=database
QUEUE_CONNECTION=database

# ─── E-mail (Resend) ───────────────────────────────────────────────────────────
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@seudominio.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# ─── APIs externas ─────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_TOKEN_URL=https://accounts.spotify.com/api/token
SPOTIFY_API_URL=https://api.spotify.com/v1

TMDB_TOKEN=
TMDB_API_URL=https://api.themoviedb.org/3

RAPIDAPI_KEY=
RAPIDAPI_SOUNDTRACK_HOST=soundtrack-playlists.p.rapidapi.com
RAPIDAPI_SOUNDTRACK_URL=https://soundtrack-playlists.p.rapidapi.com/

# ─── Apenas desenvolvimento local ─────────────────────────────────────────────
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
